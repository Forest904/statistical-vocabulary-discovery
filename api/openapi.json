              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "term_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Term Id"
            }
          },
          {
            "in": "query",
            "name": "relation_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "broader_than",
                    "narrower_than",
                    "variant_of",
                    "related_to"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Relation Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RelationListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Relations",
        "tags": [
          "artifacts"
        ]
      }
    },
    "/api/search": {
      "post": {
        "description": "Search source tables with grounded evidence.",
        "operationId": "search_api_search_post",
        "requestBody": {
          "content": {
