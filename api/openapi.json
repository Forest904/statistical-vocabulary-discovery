    },
    "/api/relations": {
      "get": {
        "description": "Return paginated measure relations.",
        "operationId": "relations_api_relations_get",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 1000,
              "minimum": 1,
