              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Evaluation",
        "tags": [
          "artifacts"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Return loaded-run and artifact readiness.",
        "operationId": "health_api_health_get",
