    "/api/relations": {
      "get": {
        "tags": [
          "artifacts"
        ],
        "summary": "Relations",
        "description": "Return paginated measure relations.",
        "operationId": "relations_api_relations_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "term_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
